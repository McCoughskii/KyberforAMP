      "FieldName": "MaxPlayers",
      "ParamFieldName": "MaxPlayers",
      "DefaultValue": "40",
      "Category": "category.kyber:rocket_launch",
      "Subcategory": "category.server:dns:2",
      "DisplayName": "setting.MaxPlayers.name",
      "Description": "setting.MaxPlayers.desc",
      "Keywords": "players,slots,max",
      "InputType": "number",
