  "ConfigFileMappings": [],
  "Locale": {
    "en": {
      "meta.name": "KYBER (Star Wars Battlefront II)",
      "meta.description": "KYBER dedicated server for Star Wars Battlefront II (2017). Peer to peer - no ports to open.",
      "category.kyber": "Kyber",
      "category.accounts": "Accounts",
      "category.server": "Server",
      "category.admins": "Admins",
      "category.rotation": "Map Rotation",
      "category.mods": "Mods & Plugins",
      "category.game": "Game Files",
      "category.module": "KYBER Module",
      "category.logging": "Logging & Debug",
      "category.runtime": "Runtime (Advanced)",
      "setting.EAEmail.name": "EA Email",
      "setting.EAEmail.desc": "Email address (or EA ID) of the EA account that owns Star Wars Battlefront II. The server logs in to EA with it on every start.",
      "setting.EAPassword.name": "EA Password",
      "setting.EAPassword.desc": "Password of that EA account. Accounts with two-factor sign-in may need it turned off for the server to log in.",
      "setting.KyberToken.name": "KYBER Token",
      "setting.KyberToken.desc": "Your KYBER API token. Create it once with `kyber_cli get_token` (KYBER launcher or CLI on any PC). It does not expire.",
      "setting.ServerName.name": "Server Name",
      "setting.ServerName.desc": "Name shown in the KYBER server browser. Maximum 24 characters.",
      "setting.ServerDescription.name": "Server Description",
      "setting.ServerDescription.desc": "Longer description for rules, Discord links and so on. Maximum 256 characters.",
      "setting.ServerPassword.name": "Server Password",
      "setting.ServerPassword.desc": "Password players must enter to join. Leave blank for a public server.",
      "setting.Admins.name": "Server Admins",
      "setting.Admins.desc": "KYBER/EA usernames or user IDs to make admins (KYBER moderators) of this server, one per line. They are added once the server has registered with KYBER, and can then moderate it from the KYBER launcher. Type `admins` in the console to list the current admins.",
      "setting.AdminsExclusive.name": "Only These Admins",
      "setting.AdminsExclusive.desc": "Also remove admins that are not in the list above (for example ones added from the KYBER launcher).",
      "setting.AdminsExclusive.value.False": "Disabled",
      "setting.AdminsExclusive.value.True": "Enabled",
      "setting.MaxPlayers.name": "Max Players",
      "setting.MaxPlayers.desc": "Maximum number of players (1-64).",
      "setting.MapRotation.name": "Map Rotation",
      "setting.MapRotation.desc": "One entry per map as `mode;map`. Paste the base64 string from the KYBER launcher (Host > NEW > add maps > Export), or type `mode;map` lines such as `PlanetaryBattles;S5_1/Levels/MP/Geonosis_01/Geonosis_01`. The launcher's JSON export also works.",
      "setting.UseMods.name": "Load Mod Collection",
      "setting.UseMods.desc": "Loads a KYBER mod collection (for example Battlefront Plus) from the `mods` folder. Upload the collection file (.kbcollection, or the .fbcollection from the launcher's mods folder) and all of its mods directly into `mods` with the File Manager and restart. Players need the same collection to join.",
      "setting.UseMods.value.False": "Disabled",
      "setting.UseMods.value.True": "Enabled",
      "setting.UsePlugins.name": "Enable Plugins Folder",
      "setting.UsePlugins.desc": "Uses the `plugins` folder as the KYBER plugins path. Plugins are experimental and unsupported by KYBER.",
      "setting.UsePlugins.value.False": "Disabled",
      "setting.UsePlugins.value.True": "Enabled",
      "setting.GameDir.name": "Game Directory",
      "setting.GameDir.desc": "Folder holding starwarsbattlefrontii.exe, as seen inside the shard. Leave blank for the `battlefront` folder of this server.",
      "setting.VerifyGame.name": "Verify Game Files on Update",
      "setting.VerifyGame.desc": "Re-run the EA download on every Update to check and repair the game files. Needs a fresh EA token. When disabled, Update skips the download once starwarsbattlefrontii.exe is in the game folder.",
      "setting.VerifyGame.value.False": "Disabled",
      "setting.VerifyGame.value.True": "Enabled",
      "setting.EAToken.name": "EA Token (game download only)",
      "setting.EAToken.desc": "Only needed to download or verify the game files on Update. Create one with `kyber_cli get_ea_token`; EA tokens expire quickly, so paste a fresh one right before updating. The server itself logs in with the EA email and password.",
      "setting.ModuleChannel.name": "KYBER Module Channel",
      "setting.ModuleChannel.desc": "Release channel of the KYBER module the server loads.",
      "setting.ModuleChannel.value.default": "Default",
      "setting.ModuleChannel.value.stable": "stable",
      "setting.ModuleChannel.value.custom": "Custom (set below)",
      "setting.ModuleChannelCustom.name": "Custom Module Channel",
      "setting.ModuleChannelCustom.desc": "Used when the channel above is Custom, e.g. `ver/beta10`.",
      "setting.LogLevel.name": "Log Level",
      "setting.LogLevel.desc": "KYBER log verbosity. debug and trace also turn on kyber_cli --verbose. The EA login and tokens are replaced with **** in the console.",
      "setting.LogLevel.value.info": "info",
      "setting.LogLevel.value.debug": "debug",
      "setting.LogLevel.value.trace": "trace",
      "setting.MaximaDebug.name": "Maxima Debug Output",
      "setting.MaximaDebug.desc": "Adds --debug to kyber_cli for troubleshooting EA login problems.",
      "setting.MaximaDebug.value.False": "Disabled",
      "setting.MaximaDebug.value.True": "Enabled",
      "setting.KyberImage.name": "KYBER Image (runtime source)",
      "setting.KyberImage.desc": "The KYBER files (kyber_cli, maxima, module) are taken from this image on every Update.",
      "setting.WineUrl.name": "Wine Build URL",
      "setting.WineUrl.desc": "Wine build used to run the server. Default is the GE-Proton8-26 build KYBER ships.",
      "setting.$MaxUsers.name": "Maximum Users (AMP)",
      "setting.$MaxUsers.desc": "Player limit AMP uses for its own statistics."
    }
  }
}
