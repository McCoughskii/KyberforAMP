{
  "Id": "6b1f0c52-3e7a-4d8b-9a41-2f5c7e9d0b13",
  "TemplateSlug": "kyber",
  "Lifecycle": {
    "RootDir": "./kyber/",
    "BaseDirectory": "./kyber/",
    "ExecutableWin": "",
    "ExecutableLinux": "/bin/bash",
    "WorkingDir": "",
    "LinuxCommandLineArgs": "",
    "CommandLineArgs": "\"{{$FullRootDir}}scripts/kyber-run.sh\" \"{{$FullBaseDir}}\"",
    "CommandLineParameterFormat": "",
    "CommandLineParameterDelimiter": "",
    "ApplicationReadyMode": "RegexMatch",
    "ExitMethod": "OS_CLOSE",
    "ExitTimeout": "60",
    "ExitString": "",
    "ExitFile": ""
  },
  "Management": {
    "MaxUsers": 64,
    "HasReadableConsole": true,
    "HasWriteableConsole": true,
    "AdminMethod": "STDIO",
    "RCONHeartbeatCommand": "",
    "EnvironmentVariables": {
      "AMP_KYBER_EA_EMAIL": "{{EAEmail}}",
      "AMP_KYBER_EA_PASSWORD": "{{EAPassword}}",
      "AMP_KYBER_TOKEN": "{{KyberToken}}",
      "AMP_KYBER_SERVER_NAME": "{{ServerName}}",
      "AMP_KYBER_SERVER_DESCRIPTION": "{{ServerDescription}}",
      "AMP_KYBER_SERVER_PASSWORD": "{{ServerPassword}}",
      "AMP_KYBER_ADMINS": "{{Admins}}",
      "AMP_KYBER_ADMINS_EXCLUSIVE": "{{AdminsExclusive}}",
      "AMP_KYBER_MAX_PLAYERS": "{{MaxPlayers}}",
      "AMP_KYBER_MAP_ROTATION": "{{MapRotation}}",
      "AMP_KYBER_USE_MODS": "{{UseMods}}",
      "AMP_KYBER_USE_PLUGINS": "{{UsePlugins}}",
      "AMP_KYBER_GAME_DIR": "{{GameDir}}",
      "AMP_KYBER_EA_TOKEN": "{{EAToken}}",
      "AMP_KYBER_MODULE_CHANNEL": "{{ModuleChannel}}",
      "AMP_KYBER_MODULE_CHANNEL_CUSTOM": "{{ModuleChannelCustom}}",
      "AMP_KYBER_LOG_LEVEL": "{{LogLevel}}",
      "AMP_KYBER_MAXIMA_DEBUG": "{{MaximaDebug}}"
    }
  },
  "Metadata": {
    "DisplayName": "meta.name",
    "Description": "meta.description",
    "Author": "Serabus",
    "URL": "https://kyber.gg/",
    "DisplayImageSource": "steam:1237950",
    "EndpointURIFormat": "",
    "SpecificDockerImage": "cubecoders/amp3base:wine-devel",
    "OS": "Linux",
    "AarchSupport": "NotSupported",
    "ExtraSetupStepsURI": "https://docs.kyber.gg/g/hosting/dedicated-servers/config",
    "ConfigVersion": "25",
    "MinAMPVersion": "2.6.0.0"
  },
  "Console": {
    "ThrowawayMessageRegex": "^(?:[0-9a-f]{4}:(?:fixme|warn|trace):.*|[0-9a-f]{4}:err:(?:winediag|winstation|explorer|systray|ole|wineboot|setupapi|console|combase|dbghelp|ntoskrnl|vulkan|wgl|x11drv|d3d|hid):.*|wine: (?:configuration in .* has been updated|created the configuration directory).*|.*The explorer process failed to start.*|Could not find Wine Gecko.*|Could not find Wine Mono.*|reg: The operation completed successfully.*)$",
    "AppReadyRegex": "^.*\\[KYBER\\] \\[info\\] \\[Server\\] Server level loaded.*$",
    "UserJoinRegex": "^.*\\[KYBER\\] \\[info\\] \\[Server\\] (?<username>.+?) \\((?<userid>\\d+)\\) has authenticated and joined the server$",
    "UserLeaveRegex": "^.*\\[KYBER\\] \\[info\\] \\[Server\\] (?<username>.+?) \\((?<userid>\\d+)\\) left the server$",
    "UserChatRegex": "^.*\\[KYBER\\] \\[info\\] \\[Server\\] (?!ADMIN:)(?<username>[^ :()]+): (?<message>.+)$",
    "UpdateAvailableRegex": "^$"
  },
  "PortReferences": {
    "AdminPortRef": "0",
    "PrimaryApplicationPortRef": "0",
    "UniversalSleepApplicationUDPPortRef": "0",
    "UniversalSleepSteamQueryPortRef": "0"
  },
  "UpdateStages": [
    {
      "UpdateSource": "CreateDirectory",
      "UpdateStageName": "Create scripts folder",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceArgs": "{{$FullRootDir}}scripts"
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Download kyber-install.sh",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "https://raw.githubusercontent.com/McCoughskii/KyberforAMP/dev/scripts/kyber/kyber-install.sh?cv=25",
      "UpdateSourceArgs": "kyber-install.sh",
      "UpdateSourceTarget": "{{$FullRootDir}}scripts",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Download kyber-run.sh",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "https://raw.githubusercontent.com/McCoughskii/KyberforAMP/dev/scripts/kyber/kyber-run.sh?cv=25",
      "UpdateSourceArgs": "kyber-run.sh",
      "UpdateSourceTarget": "{{$FullRootDir}}scripts",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "FetchURL",
      "UpdateStageName": "Download kyber-api.py",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "https://raw.githubusercontent.com/McCoughskii/KyberforAMP/dev/scripts/kyber/kyber-api.py?cv=25",
      "UpdateSourceArgs": "kyber-api.py",
      "UpdateSourceTarget": "{{$FullRootDir}}scripts",
      "OverwriteExistingFiles": true
    },
    {
      "UpdateSource": "Executable",
      "UpdateStageName": "Install KYBER runtime, Wine and game files",
      "UpdateSourcePlatform": "Linux",
      "UpdateSourceData": "/bin/bash",
      "UpdateSourceArgs": "-c \"chmod +x '{{$FullRootDir}}scripts/'*.sh; KYBER_IMAGE='{{KyberImage}}' KYBER_WINE_URL='{{WineUrl}}' KYBER_GAME_DIR='{{GameDir}}' KYBER_EA_TOKEN='{{EAToken}}' KYBER_VERIFY_GAME='{{VerifyGame}}' '{{$FullRootDir}}scripts/kyber-install.sh' '{{$FullBaseDir}}'\""
    }
  ],
  "PortRequirements": [],
  "BackupExclusions": [
    "battlefront/",
    "wine/",
    "wine.new/",
    "runtime/",
    "runtime.new/",
    ".kyber-tmp/",
    ".kyber-api/"
  ],
  "Settings": [
    {
      "FieldName": "EAEmail",
      "ParamFieldName": "EAEmail",
      "DefaultValue": "",
      "Category": "category.kyber:rocket_launch",
      "Subcategory": "category.accounts:key:1",
      "DisplayName": "setting.EAEmail.name",
      "Description": "setting.EAEmail.desc",
      "Keywords": "ea,email,login,account,maxima,credentials",
      "InputType": "text"
    },
    {
      "FieldName": "EAPassword",
      "ParamFieldName": "EAPassword",
      "DefaultValue": "",
      "Category": "category.kyber:rocket_launch",
      "Subcategory": "category.accounts:key:1",
